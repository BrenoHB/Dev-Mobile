{
  "expo": {
    "name": "exchanger",
    "slug": "exchanger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "exchanger",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.joaotelles.exchanger",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23f977e8-89f2-48e5-941d-1bd0980995db"
      }
    }
  }
}
